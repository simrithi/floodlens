{
  "Comment": "FloodLens pipeline: per-frame SageMaker analysis (Map, serial -- the endpoint is single-worker), then assemble risk cells",
  "StartAt": "AnalyzeFrames",
  "States": {
    "AnalyzeFrames": {
      "Type": "Map",
      "ItemsPath": "$.frames",
      "MaxConcurrency": 1,
      "ResultPath": "$.frameRecords",
      "ItemSelector": {
        "frame.$": "$$.Map.Item.Value",
        "rawBucket.$": "$.rawBucket",
        "rawPrefix.$": "$.rawPrefix",
        "outputBucket.$": "$.outputBucket",
        "outputPrefix.$": "$.outputPrefix"
      },
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "InvokeFrame",
        "States": {
          "InvokeFrame": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${InvokeFrameFunctionArn}",
              "Payload.$": "$"
            },
            "ResultSelector": { "Payload.$": "$.Payload" },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException", "Lambda.SdkClientException"],
                "IntervalSeconds": 3,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "End": true
          }
        }
      },
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "MarkFailed", "ResultPath": "$.error" }],
      "Next": "Assemble"
    },
    "Assemble": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AssembleResultsFunctionArn}",
        "Payload": {
          "runId.$": "$.runId",
          "sequenceId.$": "$.sequenceId",
          "size.$": "$.size",
          "frameRecords.$": "$.frameRecords"
        }
      },
      "ResultSelector": { "Payload.$": "$.Payload" },
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "MarkFailed", "ResultPath": "$.error" }],
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "floodlens-runs",
        "Key": { "runId": { "S.$": "$.runId" } },
        "UpdateExpression": "SET #s = :s",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": { ":s": { "S": "failed" } }
      },
      "End": true
    }
  }
}
